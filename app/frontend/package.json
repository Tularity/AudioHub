{
  "name": "audiohub-ui",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "typecheck": "tsc -b --force",
    "preview": "vite preview",
    "check-test-project": "node scripts/check-test-project.mjs",
    "pretest": "npm run check-test-project",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
