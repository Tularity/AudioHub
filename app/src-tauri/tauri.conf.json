{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioHub",
  "version": "1.0.1",
  "identifier": "com.audiohub.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "beforeDevCommand": "npm --prefix frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AudioHub",
        "width": 1000,
        "height": 700,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "licenseFile": "../../LICENSE",
    "resources": {
      "../../LICENSE": "licenses/AudioHub-LICENSE.txt",
      "../../NOTICE.md": "licenses/AudioHub-NOTICE.md",
      "../../THIRD-PARTY-LICENSES.html": "licenses/THIRD-PARTY-LICENSES.html",
      "locales/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "locales/zh-Hans.lproj/InfoPlist.strings": "zh-Hans.lproj/InfoPlist.strings"
    },
    "targets": [
      "app"
    ],
    "category": "Music",
    "shortDescription": "跨主机网络音频共享",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/audiohub",
      "binaries/audiohubd"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "headerImage": "../../assets/installer/nsis-header.bmp",
        "sidebarImage": "../../assets/installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
