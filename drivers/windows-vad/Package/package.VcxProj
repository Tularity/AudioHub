    <!-- Driver Verifier is ON for deployment. It bugchecked the target three
         times for three runs with 0xC4 / P1=0x0012001B, bit-identical, until
         2026-08-09; `!analyze -v` named the rule IrqlObPassive, i.e.
         "ObReferenceObjectByHandle should only be called at IRQL =
         PASSIVE_LEVEL". The call sat inside the ExAcquireFastMutex region in
         AhRingsMap, and a fast mutex raises IRQL to APC_LEVEL. Fixed by
         hoisting the reference above the acquire; see the g_AhMapLock comment
         in Source/Main/ahrings.cpp.

         NOTE FOR THE NEXT EDITOR: an XML comment may not contain two adjacent
         hyphens. The previous version of this comment did, and MSBuild refused
         to load this project file with error MSB4025 from the moment it landed.
         Only the package project broke, so AudioHubVad.sys kept building and
         nothing noticed until the next packaging run. -->
    <EnableVerifier>True</EnableVerifier>
    <AllDrivers>False</AllDrivers>
    <VerifyProjectOutput>True</VerifyProjectOutput>
    <VerifyDrivers />
    <VerifyFlags>133563</VerifyFlags>
  </PropertyGroup>
